# ==============================================================================
# CONFIGURACAO DE VARIAVEIS DE AMBIENTE - PROJETO AGUIA BRANCA (SPRINT 2)
# ==============================================================================
# IMPORTANTE: Nunca envie credenciais reais para o Git!
# Copie este arquivo para .env ou preencha o backend/src/appsettings.json localmente.
# Envie as credenciais reais aos colegas via chat privado seguro.
# ==============================================================================

# String de conexao com o MongoDB Atlas:
MONGODB_URI=mongodb+srv://<USUARIO>:<SENHA>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Nome do Banco de Dados:
MONGODB_DATABASE=InovacaoAguiaBrancaDB

# Segredo para assinatura de Tokens JWT (minimo 32 caracteres):
JWT_SECRET=seu_segredo_aqui_minimo_32_caracteres_super_seguro

# Chave de API do Google Gemini (opcional - fallback inteligente disponivel se vazio):
GEMINI_API_KEY=
